# =============================================================================
# USolve Corporate Website - Environment Configuration Template
# Copy this file to .env.local for local testing, or configure in your hosting platform.
# NEVER commit your actual .env or secrets to Git!
# =============================================================================

# [Required for Production SEO]
# The canonical domain of the live website (e.g. https://usolve.in or https://your-domain.com)
# Defaults to https://usolve.in if omitted.
VITE_SITE_URL=https://usolve.in

# [Contact Form Delivery - Active Client Endpoint]
# Configured Formspree endpoint that delivers customer inquiries directly to usolveofficial@gmail.com.
# In production (e.g. Vercel / Netlify), set this environment variable in the dashboard.
# Note: Since Vite bundles environment variables at build time, trigger a new deployment after updating.
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID

# [Cloudflare Turnstile Bot Protection - Client Site Key (Free Tier)]
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Site
# Leave empty during initial local development; configure for production abuse prevention.
VITE_TURNSTILE_SITE_KEY=

# =============================================================================
# SERVERLESS ONLY (Configured in Vercel dashboard, NOT in client code)
# Never prefix secrets with VITE_ to prevent leaking into browser bundles.
# =============================================================================

# [Cloudflare Turnstile Secret Key - Serverless Only]
# Secret key paired with VITE_TURNSTILE_SITE_KEY for server-side token validation.
TURNSTILE_SECRET_KEY=

# [Google Apps Script Confirmation Email - 100% Free via MailApp]
# 1. Deploy google-apps-script/Code.gs as a Web App (Execute as: Me / Anyone)
# 2. Add SHARED_SECRET in Apps Script Project Settings -> Script Properties
# 3. Add these two variables in Vercel Project Settings -> Environment Variables:
USOLVE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
USOLVE_EMAIL_SHARED_SECRET=replace_with_a_long_random_hex_or_uuid_secret

# [Optional Alternative: Resend Transactional Email]
# RESEND_API_KEY=re_your_api_key_here
# CONTACT_NOTIFICATION_EMAIL=usolveofficial@gmail.com
# VERIFIED_SENDER_EMAIL=inquiries@usolve.in
