# =============================================================================
# USolve Corporate Website - Environment Configuration Template
# Copy this file to .env.local for local testing, or configure in your hosting platform.
# NEVER commit your actual .env or secrets to Git!
# =============================================================================

# [Required for Production SEO]
# The canonical domain of the live website (e.g. https://usolve.in or https://your-domain.com)
# Defaults to https://usolve.in if omitted.
VITE_SITE_URL=https://usolve.in

# [Contact Form Delivery - Client Endpoint]
# Option A: Hosted Form Endpoint (e.g. Formspree: https://formspree.io/f/xyzabced)
# Option B: Serverless API Route (e.g. /api/contact when hosted on Vercel/Netlify)
# If left empty, the contact form gracefully provides a validated inquiry preview
# and direct mailto/phone delivery channels.
VITE_CONTACT_FORM_ENDPOINT=

# =============================================================================
# SERVERLESS ONLY (Configured in Vercel / Netlify dashboard, NOT in client code)
# =============================================================================
# RESEND_API_KEY=re_your_api_key_here
# CONTACT_NOTIFICATION_EMAIL=usolveofficial@gmail.com
# VERIFIED_SENDER_EMAIL=inquiries@usolve.in
